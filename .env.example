# Public wallet/position metadata. Keep it in the private repository settings.
WALLET_ADDRESS=your_public_wallet_address
POSITION_ADDRESS=your_public_meteora_position_address
POOL_ADDRESS=C8Gr6AUuq9hEdSYJzoEpNcdjpojPZwqG5MtQbeouNNwg
POSITION_CENTER_BIN_ID=record_the_active_bin_at_entry

# Record these from the final signed deposit, not from an estimate.
INITIAL_DEPLOYED_SOL=19.88
INITIAL_DEPLOYED_USD=record_usd_value_at_entry
EXTERNAL_COSTS_USD=record_swap_and_network_costs

# Telegram credentials belong in GitHub Actions secrets, never in this file.
TELEGRAM_BOT_TOKEN=set_as_a_github_actions_secret
TELEGRAM_CHAT_ID=set_as_a_github_actions_secret

# Conservative defaults. Change only through a reviewed commit.
NOISE_LOSS_PCT=-0.5
YELLOW_ALPHA_PCT=-2
RED_LOSS_PCT=-2
CRITICAL_LOSS_PCT=-5
MAX_DATA_AGE_MINUTES=15
HEARTBEAT_HOUR_UTC=15
DANGER_REMINDER_HOURS=6
STATE_PATH=state/monitor.json
